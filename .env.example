# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (For Vercel deployment, use MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/ai-study-planner
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/ai-study-planner?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ai-study-planner

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Web Client ID (for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Groq AI API Key (Optional)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: OpenAI API Key
OPENAI_API_KEY=your_openai_key_here
